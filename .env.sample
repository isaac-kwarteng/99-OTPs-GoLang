APP.NAME="Marketdome OTP"
APP.VERSION=v1
APP.PORT=8080
APP.ENV=development
APP.DEBUG=true

REDIS.URL=redis://localhost:6379/1

# SMS provider: arkesel | mnotify | http | jasmin
#   arkesel  SMS.API_KEY, SMS.SENDER_ID (SMS.API_URL optional)
#   mnotify  SMS.API_KEY, SMS.SENDER_ID (SMS.API_URL optional)
#   http     SMS.API_URL, SMS.API_KEY, SMS.SENDER_ID (generic JSON + bearer token)
#   jasmin   SMS.API_URL, SMS.USERNAME, SMS.PASSWORD, SMS.SENDER_ID
# The values below use the local Jasmin stack from docker-compose.yml.
SMS.PROVIDER=jasmin
SMS.API_URL=http://localhost:1401/send
SMS.API_KEY=
SMS.USERNAME=otpuser
SMS.PASSWORD=otppass
SMS.SENDER_ID=TestOTP
